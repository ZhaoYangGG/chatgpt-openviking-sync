{
  "manifest_version": 3,
  "name": "ChatGPT to OpenViking",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Sync observed ChatGPT text conversations to OpenViking with source timestamps and best-effort deduplication.",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/v2-sync-worker.js"
  },
  "action": {
    "default_popup": "src/popup/v2-sync-popup.html",
    "default_title": "ChatGPT → OpenViking"
  },
  "options_ui": {
    "page": "src/options/v2-options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/capture/signed-relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
