{
  "manifest_version": 3,
  "name": "OpenViking P0 · 只读采集验证",
  "version": "0.2.0",
  "minimum_chrome_version": "111",
  "description": "只观察 ChatGPT 自然详情响应，数据仅保存在本机，不上传 OpenViking。",
  "permissions": ["activeTab"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "P0 只读验证"},
  "content_scripts": [
    {"matches": ["https://chatgpt.com/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://chatgpt.com/*"], "js": ["relay.js"], "run_at": "document_start", "world": "ISOLATED"}
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}
